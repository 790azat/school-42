RewriteEngine On

# --- Clean, extension-less URLs (e.g. /about instead of /about.html) ---

# 1) If someone requests the .html file directly, redirect the browser to
#    the clean URL so the address bar never shows the extension.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\s?] [NC]
RewriteRule ^index\.html$ /? [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally serve the matching .html file for a clean URL, without
#    changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php74" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
